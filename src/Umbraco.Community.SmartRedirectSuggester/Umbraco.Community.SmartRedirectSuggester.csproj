<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1507;NU1902;NU1903;NU5104</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Umbraco.Community.SmartRedirectSuggester</Product>
    <PackageId>Umbraco.Community.SmartRedirectSuggester</PackageId>
    <Title>Smart Redirect Suggester</Title>
    <Description>Improve the Umbraco trash flow by suggesting redirect targets for published content before it is moved to the recycle bin.</Description>
    <PackageTags>umbraco;umbraco-marketplace;redirects;seo;backoffice;search;url-tracking</PackageTags>
    <Authors>Søren Kottal</Authors>
    <Copyright>$([System.DateTime]::UtcNow.ToString(`yyyy`)) © Søren Kottal</Copyright>
    <PackageProjectUrl>https://github.com/skttl/umbraco-smart-redirect-suggester</PackageProjectUrl>
    <RepositoryUrl>https://github.com/skttl/umbraco-smart-redirect-suggester</RepositoryUrl>
    <PackageReadmeFile>MARKETPLACE-README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" />
    <PackageReference Include="Umbraco.Cms.Web.Common" />
    <PackageReference Include="Umbraco.Cms.Api.Common" />
    <PackageReference Include="Umbraco.Cms.Api.Management" />
    <PackageReference Include="Umbraco.Cms.Search.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dont include the client folder as part of packaging nuget build -->
    <Content Remove="Client\**" />

    <!-- However make the Umbraco-package.json included for dotnet pack or nuget package and visible to the solution -->
    <None Include="Client\public\umbraco-package.json" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="MARKETPLACE-README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>

    <None Include="..\..\assets\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
      <Link>icon.png</Link>
    </None>
  </ItemGroup>

</Project>
