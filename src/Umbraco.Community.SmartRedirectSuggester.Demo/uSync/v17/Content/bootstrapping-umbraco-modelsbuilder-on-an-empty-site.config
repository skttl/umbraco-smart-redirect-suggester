<?xml version="1.0" encoding="utf-8"?>
<Content Key="e30cd76b-dbe8-4d6f-94f3-a0d918d694d1" Alias="Bootstrapping Umbraco ModelsBuilder on an empty site" Level="3">
  <Info>
    <Parent Key="31523089-f648-4883-9087-ef9a0b83129f">Blog</Parent>
