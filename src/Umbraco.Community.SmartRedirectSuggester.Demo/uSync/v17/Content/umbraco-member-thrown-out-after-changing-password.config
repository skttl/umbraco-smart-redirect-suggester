<?xml version="1.0" encoding="utf-8"?>
<Content Key="638d1e55-c19b-4010-b111-7e4f6bc09a73" Alias="Umbraco Member thrown out after changing password" Level="3">
  <Info>
    <Parent Key="31523089-f648-4883-9087-ef9a0b83129f">Blog</Parent>
    <Path>/Home/Blog/UmbracoMemberThrownOutAfterChangingPassword</Path>
    <Trashed>false</Trashed>
