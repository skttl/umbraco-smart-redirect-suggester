<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CompressionEnabled>false</CompressionEnabled> <!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Clean" Version="7.0.5" />
    <PackageReference Include="Umbraco.AI" Version="1.10.1" />
    <PackageReference Include="Umbraco.AI.Agent" Version="1.9.0" />
    <PackageReference Include="Umbraco.AI.Agent.Copilot" Version="1.0.0-alpha7" />
    <PackageReference Include="Umbraco.AI.Amazon" Version="1.1.2" />
    <PackageReference Include="Umbraco.AI.Anthropic" Version="1.3.0" />
    <PackageReference Include="Umbraco.AI.Google" Version="1.1.5" />
    <PackageReference Include="Umbraco.AI.MicrosoftFoundry" Version="1.2.0" />
    <PackageReference Include="Umbraco.AI.OpenAI" Version="1.2.0" />
    <PackageReference Include="Umbraco.AI.Prompt" Version="1.8.2" />
    <PackageReference Include="Umbraco.AI.Search.Startup" Version="1.0.0-beta4" />
    <PackageReference Include="Umbraco.Cms" Version="17.0.0" />
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="17.0.0" />
    <PackageReference Include="Umbraco.Cms.Search.Provider.Examine" Version="1.0.0-beta.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <PackageReference Include="uSync" Version="17.0.0" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Umbraco.Community.SmartRedirectSuggester\Umbraco.Community.SmartRedirectSuggester.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

</Project>
