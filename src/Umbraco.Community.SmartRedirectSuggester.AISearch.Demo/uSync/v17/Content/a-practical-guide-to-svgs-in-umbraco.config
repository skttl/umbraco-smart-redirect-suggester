026quot;\u0026gt;}\u0026lt;/span\u0026gt;\n\n                        \u0026lt;span class=\u0026quot;n\u0026quot;\u0026gt;svgNode\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;.\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;n\u0026quot;\u0026gt;Attributes\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;.\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;nf\u0026quot;\u0026gt;Remove\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;s\u0026quot;\u0026gt;\u0026quot;width\u0026quot;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;);\u0026lt;/span\u0026gt;\n                        \u0026lt;span class=\u0026quot;n\u0026quot;\u0026gt;svgNode\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;.\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;n\u0026quot;\u0026gt;Attributes\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;.\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;nf\u0026quot;\u0026gt;Remove\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;s\u0026quot;\u0026gt;\u0026quot;height\u0026quot;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;);\u0026lt;/span\u0026gt;\n                    \u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;}\u0026lt;/span\u0026gt;\n\n                    \u0026lt;span class=\u0026quot;n\u0026quot;\u0026gt;svgNode\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;.\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;n\u0026quot;\u0026gt;Attributes\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;.\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;nf\u0026quot;\u0026gt;Remove\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;s\u0026quot;\u0026gt;\u0026quot;xmlns\u0026quot;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;);\u0026lt;/span\u0026gt;\n                \u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;}\u0026lt;/span\u0026gt;\n\n                \u0026lt;span class=\u0026quot;n\u0026quot;\u0026gt;fileContents\u0026lt;/span\u0026gt; \u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;=\u0026lt;/span\u0026gt; \u0026lt;span class=\u0026quot;n\u0026quot;\u0026gt;doc\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;.\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;n\u0026quot;\u0026gt;DocumentNode\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;.\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;n\u0026quot;\u0026gt;OuterHtml\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;;\u0026lt;/span\u0026gt;\n                \u0026lt;span class=\u0026quot;n\u0026quot;\u0026gt;svg\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;.\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;nf\u0026quot;\u0026gt;SetValue\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;n\u0026quot;\u0026gt;SvgContentPropertyAlias\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;,\u0026lt;/span\u0026gt; \u0026lt;span class=\u0026quot;n\u0026quot;\u0026gt;fileContents\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;);\u0026lt;/span\u0026gt;\n            \u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;}\u0026lt;/span\u0026gt;\n            \u0026lt;span class=\u0026quot;k\u0026quot;\u0026gt;catch\u0026lt;/span\u0026gt; \u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;n\u0026quot;\u0026gt;Exception\u0026lt;/span\u0026gt; \u0026lt;span class=\u0026quot;n\u0026quot;\u0026gt;ex\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt; \u0026lt;span class=\u0026quot;k\u0026quot;\u0026gt;when\u0026lt;/span\u0026gt; \u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;n\u0026quot;\u0026gt;ex\u0026lt;/span\u0026gt; \u0026lt;span class=\u0026quot;k\u0026quot;\u0026gt;is\u0026lt;/span\u0026gt; \u0026lt;span class=\u0026quot;n\u0026quot;\u0026gt;IOException\u0026lt;/span\u0026gt;\n                \u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;||\u0026lt;/span\u0026gt; \u0026lt;span class=\u0026quot;n\u0026quot;\u0026gt;ex\u0026lt;/span\u0026gt; \u0026lt;span class=\u0026quot;k\u0026quot;\u0026gt;is\u0026lt;/span\u0026gt; \u0026lt;span class=\u0026quot;n\u0026quot;\u0026gt;FileNotFoundException\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\n            \u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;{\u0026lt;/span\u0026gt;\n                \u0026lt;span class=\u0026quot;n\u0026quot;\u0026gt;_logger\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;.\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;nf\u0026quot;\u0026gt;LogError\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;n\u0026quot;\u0026gt;ex\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;,\u0026lt;/span\u0026gt;\n                    \u0026lt;span class=\u0026quot;s\u0026quot;\u0026gt;\u0026quot;Unable to read file to set SVG content \u0026quot;\u0026lt;/span\u0026gt;\n                    \u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;\u002B\u0026lt;/span\u0026gt; \u0026lt;span class=\u0026quot;s\u0026quot;\u0026gt;\u0026quot;for media item with ID {MediaId}.\u0026quot;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;,\u0026lt;/span\u0026gt;\n                    \u0026lt;span class=\u0026quot;n\u0026quot;\u0026gt;svg\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;.\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;n\u0026quot;\u0026gt;Id\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;);\u0026lt;/span\u0026gt;\n            \u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;}\u0026lt;/span\u0026gt;\n        \u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;}\u0026lt;/span\u0026gt;\n    \u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;}\u0026lt;/span\u0026gt;\n\u0026lt;span class=\u0026quot;p\u0026quot;\u0026gt;}\u0026lt;/span\u0026gt;\n\u0026lt;/code\u0026gt;\u0026lt;/pre\u0026gt;\n\n\u0026lt;/div\u0026gt;\n\n\n\n\u0026lt;h2\u0026gt;\n  \n  \n  References\n\u0026lt;/h2\u0026gt;\n\n\u0026lt;ul\u0026gt;\n\u0026lt;li\u0026gt;\u0026lt;a href=\u0026quot;https://docs.umbraco.com/umbraco-cms/reference/security/server-side-file-validation#ifilestreamsecurityanalyzer\u0026quot; rel=\u0026quot;noopener noreferrer\u0026quot;\u0026gt;Server-side file validation | Umbraco Documentation\u0026lt;/a\u0026gt;\u0026lt;/li\u0026gt;\n\u0026lt;li\u0026gt;\u0026lt;a href=\u0026quot;https://github.com/umbraco-community/Our-Umbraco-TagHelpers\u0026quot; rel=\u0026quot;noopener noreferrer\u0026quot;\u0026gt;Our.Umbraco.TagHelpers\u0026lt;/a\u0026gt;\u0026lt;/li\u0026gt;\n\u0026lt;/ul\u0026gt;\u003C/p\u003E\u003Cp\u003E\u003Ca href=\u0022https://dev.to/matthewwise/a-practical-guide-to-svgs-in-umbraco-1gm6\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003ERead the original article\u003C/a\u003E\u003C/p\u003E"
          }
