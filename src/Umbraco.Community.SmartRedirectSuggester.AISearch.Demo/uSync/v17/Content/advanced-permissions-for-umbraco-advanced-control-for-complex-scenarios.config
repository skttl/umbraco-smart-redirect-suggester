<?xml version="1.0" encoding="utf-8"?>
<Content Key="5b90c9f5-5680-460c-aa62-297297716afa" Alias="Advanced Permissions for Umbraco: Advanced Control for Complex Scenarios" Level="3">
  <Info>
    <Parent Key="31523089-f648-4883-9087-ef9a0b83129f">Blog</Parent>
